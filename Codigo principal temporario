typedef struct Aluno Aluno;

int BuscarAluno(int clientes,char nomeProcurar[100],Aluno aluno[]){
  int jfuncao;
  for(jfuncao=0;jfuncao<clientes;jfuncao++){
       if(strcasecmp(nomeProcurar,aluno[jfuncao].nome)==0){ 
            return jfuncao;
          }
     }
     return -1;
  }

void SalvarAluno(int clientes,Aluno aluno[]){
  Dados = fopen("dados.txt","wb");
  if(Dados == NULL){
    printf("Erro ao salvar os dados!!");
    exit(1);
  }
  fwrite(aluno,sizeof(Aluno),clientes,Dados);
  fclose(Dados);

}

int CarregarALuno(Aluno aluno[]){
  int f;
  Dados = fopen("dados.txt","rb");
  if(Dados == NULL){
    return 0;
  }

  f=fread(aluno,sizeof(Aluno),MAX,Dados);
  fclose(Dados);
  return f;
}



